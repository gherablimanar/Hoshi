# No credentials belong in browser storage, project exports or source control.
BIND_HOST=127.0.0.1
PORT=8080
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DATA_DIR=data
WEB_DIR=frontend/dist
# Optional live AI: use a model available to your own provider account. No default model is invented.
# AI_MODEL=
# AI_API_KEY=
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# Hosted single-owner engine (set securely at your host, not in the browser build):
# REQUIRE_AUTH=true
# APP_ACCESS_PASSWORD=
# ALLOWED_ORIGINS=https://gherablimanar.github.io
# EPHEMERAL_STORAGE=true
# RENDER_EXTERNAL_HOSTNAME is provided automatically by Render.
# Optional PUBLIC frontend build values, never secrets:
# VITE_ENGINE_URL=https://your-actual-engine-host
# VITE_BASE_PATH=/Hoshi/
